{
  "name": "@scholaris/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./puertos": "./src/puertos.ts",
    "./compartido/*": "./src/compartido/*.ts"
  },
  "scripts": {
    "dev": "wrangler dev -c ../../deploy/cloudflare/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tipos": "wrangler types -c ../../deploy/cloudflare/wrangler.jsonc src/worker-configuration.d.ts",
    "desplegar": "pnpm --filter @scholaris/web build && wrangler deploy -c ../../deploy/cloudflare/wrangler.jsonc",
    "desplegar:produccion": "pnpm --filter @scholaris/web build && wrangler deploy -c ../../deploy/cloudflare/wrangler.jsonc --env produccion"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@scholaris/busqueda": "workspace:^",
    "@scholaris/citas": "workspace:^",
    "@scholaris/contrato": "workspace:^",
    "@scholaris/folios": "workspace:^",
    "@scholaris/funciones": "workspace:^",
    "@scholaris/imprenta": "workspace:^",
    "@scholaris/ingesta": "workspace:^",
    "@scholaris/nucleo": "workspace:^",
    "@scholaris/proveedores": "workspace:^",
    "@scholaris/spdf": "workspace:^",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.3",
    "hono": "^4.9.0",
    "jose": "^6.2.12"
  }
}
